{
  "schema_version": 1,
  "workspace": {
    "projects_dir": "projects",
    "default_project": "projects/hello_world",
    "environment_file": "Environment",
    "run_dir": ".codex-runs/mosaico"
  },
  "dependencies": {
    "bsp": "submodule/esp-mosaico-bsp",
    "esp_iris": "submodule/esp-mosaico-tools/submodule/esp-iris"
  },
  "build": {
    "runner": "builtin"
  },
  "devices": [
    {
      "id": "esp-mosaico",
      "name": "ESP-Mosaico",
      "target": "esp32s31",
      "status": "supported",
      "default": true,
      "preview_target": true,
      "recovery_usb_ids": [
        {
          "vid": "0x303a",
          "pid": "0x0020",
          "product": "ESP32-S31"
        }
      ]
    }
  ]
}
