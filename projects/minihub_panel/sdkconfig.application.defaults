# Keep the OTA writer only in the retained factory Recovery image. The normal
# application exposes the enter-Recovery RPC through iris_ota_support_start().
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico minihub_panel"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000

# Embedded MiniHub: Wi-Fi stays with the panel; Host serves REST on :80.
# CONFIG_MINIHUB_NET_ETH is not set
# CONFIG_MINIHUB_NET_WIFI_STA is not set
# CONFIG_MINIHUB_LCD_UI is not set
# CONFIG_MINIHUB_USB_MSC is not set
# CONFIG_MINIHUB_RAINMAKER is not set
# CONFIG_MINIHUB_MCP_SERVER is not set
CONFIG_MINIHUB_MATTER_ADAPTER=y
# CONFIG_MINIHUB_DYNAMIC_MODULES is not set
CONFIG_MINIHUB_MQTT_ADAPTER=y
CONFIG_MINIHUB_MODBUS=y
CONFIG_MINIHUB_MODBUS_UART_TXD=-1
CONFIG_MINIHUB_MODBUS_UART_RXD=-1
CONFIG_MINIHUB_MODBUS_UART_RTS=-1
# CONFIG_MINIHUB_RTSP_CAM is not set
CONFIG_MINIHUB_WEB_UI=y
CONFIG_MINIHUB_WEB_LOGIN_AUTH=y
# CONFIG_MINIHUB_WIFI_PROVISIONING is not set
CONFIG_HTTPD_WS_SUPPORT=y
# Match official MiniHub so CHIP mDNS FindOperational has enough UDP/POSIX
# sockets after HTTPD takes its share.
CONFIG_LWIP_MAX_SOCKETS=50
CONFIG_LWIP_MAX_UDP_PCBS=16
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_ESP_COEX_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Matter commissioner: BLE commissions Wi-Fi Matter devices. The Thread release
# variant additionally links the real OpenThread Border Router component.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CTRL_ALLOW_MALLOC_FROM_SPIRAM=y
CONFIG_ENABLE_ESP32_BLE_CONTROLLER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=2
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=6
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4
CONFIG_BT_LE_CONN_RESERVED_MEMORY_COUNT=1
CONFIG_BT_LE_EXT_ADV_RESERVED_MEMORY_COUNT=1
CONFIG_BT_LE_LL_DUP_SCAN_LIST_COUNT=10
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n
CONFIG_ENABLE_CHIP_CONTROLLER_BUILD=y
CONFIG_ESP_MATTER_CONTROLLER_ENABLE=y
CONFIG_ESP_MATTER_COMMISSIONER_ENABLE=y
CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER=n
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_CHIP_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_CHIP_TASK_STACK_SIZE=15360
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_NUM_UDP_ENDPOINTS=16
CONFIG_LWIP_IPV6_NUM_ADDRESSES=12
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_WIFI_NETWORK_COMMISSIONING_DRIVER=n
CONFIG_CHIP_PROJECT_CONFIG="../../../esp-minihub/components/minihub_matter/matter_project_config.h"
# CONFIG_CHIP_DEVICE_ENABLE_DYNAMIC_SERVER is not set
# CONFIG_ESP_MATTER_OTA_PROVIDER_ENABLED is not set
# CONFIG_ESP_MATTER_OTA_CANDIDATES_UPDATE_PERIODICALLY is not set
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM=y
CONFIG_ESP_GSP_ANIM_FRAME_MEMORY_SPIRAM=y
CONFIG_ESP_GSP_DECODE_TASK_STACK_PSRAM=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=3

CONFIG_MINIHUB_PANEL_HUB_URL="http://127.0.0.1"
