# Keep the OTA writer only in the retained factory Recovery image. The normal
# application exposes the enter-Recovery RPC through iris_ota_support_start().
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_OTA_DEFAULT_VIA_RECOVERY=y
CONFIG_ESP_IRIS_SYSTEM_INVENTORY=y
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico GSP Hello"
CONFIG_ESP_IRIS_FIRMWARE_ROLE=1
CONFIG_ESP_IRIS_PRODUCT_CONTRACT="esp-mosaico/v1"
CONFIG_ESP_IRIS_BOARD_ID="esp-mosaico"
CONFIG_ESP_IRIS_LAYOUT_ID="mosaico-retained-recovery-v1"
CONFIG_ESP_IRIS_RECOVERY_ABI=1
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000
