{
  "schema_version": 1,
  "paths": {
    "app_recovery": {
      "base": "workspace",
      "path": "components/esp_mosaico_app_recovery"
    },
    "app_recovery_cmake": {
      "base": "workspace",
      "path": "components/esp_mosaico_app_recovery/CMakeLists.txt",
      "required": "file"
    },
    "system_update": {
      "base": "workspace",
      "path": "cmake/system_update.cmake",
      "required": "file"
    },
    "system_update_preparer": {
      "base": "workspace",
      "path": "tools/prepare_system_update.py",
      "required": "file"
    },
    "bsp_component": {
      "base": "bsp",
      "path": "components/esp-mosaico-bsp"
    },
    "iris_component": {
      "base": "esp_iris",
      "path": "components/esp_iris"
    },
    "iris_root": {
      "base": "esp_iris",
      "path": "."
    },
    "application_contract": {
      "base": "workspace",
      "path": "cmake/mosaico_application.cmake",
      "required": "file"
    },
    "gspc_fetcher": {
      "base": "workspace",
      "path": "tools/gsp-sim/fetch_gspc.py",
      "required": "file"
    },
    "gsp_partition_packer": {
      "base": "workspace",
      "path": "tools/pack_gsp_partition.py",
      "required": "file"
    }
  },
  "files": [
    {
      "source": "CMakeLists.txt",
      "replacements": [
        {
          "pattern": "^project\\(hello_world(?=[\\s)])",
          "replacement": "project({{project_name}}"
        },
        {
          "pattern": "set\\(EXTRA_COMPONENT_DIRS\\s+\"[^\"\\n]*esp_mosaico_app_recovery\"\\s*\\)",
          "replacement": "set(EXTRA_COMPONENT_DIRS\n    \"${CMAKE_CURRENT_LIST_DIR}/{{app_recovery|cmake}}\")"
        },
        {
          "pattern": "^include\\([^\\n)]*system_update\\.cmake\"?\\)",
          "replacement": "set(MOSAICO_ESP_IRIS_ROOT \"${CMAKE_CURRENT_LIST_DIR}/{{iris_root|cmake}}\")\ninclude(\"${CMAKE_CURRENT_LIST_DIR}/{{system_update|cmake}}\")"
        },
        {
          "pattern": "^include\\([^\\n)]*mosaico_application\\.cmake\"?\\)",
          "replacement": "include(\"${CMAKE_CURRENT_LIST_DIR}/{{application_contract|cmake}}\")"
        },
        {
          "pattern": "\\$\\{CMAKE_CURRENT_LIST_DIR\\}/\\.\\./\\.\\./tools/gsp-sim/fetch_gspc\\.py",
          "replacement": "${CMAKE_CURRENT_LIST_DIR}/{{gspc_fetcher|cmake}}"
        }
      ]
    },
    {
      "source": "README.md",
      "replacements": [
        {
          "pattern": "^# ESP-Mosaico Hello World$",
          "replacement": "# ESP-Mosaico {{project_name}}"
        },
        {
          "pattern": "^python mosaico\\.py iris app-update --project projects/hello_world$",
          "replacement": "python mosaico.py iris app-update --project {{project_path|shell}}"
        },
        {
          "pattern": "^python mosaico\\.py iris system-update --project projects/hello_world$",
          "replacement": "python mosaico.py iris system-update --project {{project_path|shell}}"
        },
        {
          "pattern": "projects/hello_world/ui/main\\.json",
          "replacement": "{{project_path|shell}}/ui/main.json",
          "count": 2
        },
        {
          "pattern": "This is the single Hello World reference, replacing the former LVGL application\\nand the separate `gsp_hello` project\\.",
          "replacement": "This application was created from the GSP Hello World reference."
        },
        {
          "pattern": "- `mosaico-template\\.json`: complete source/font copy and path relocation rules\\n  used by `python mosaico\\.py project init <name>`\\.",
          "replacement": "The workspace-owned Hello World template supplies the source/font copy and\npath relocation rules; the descriptor is not copied into generated apps."
        }
      ]
    },
    {
      "source": "partitions.csv"
    },
    {
      "source": "sdkconfig.defaults"
    },
    {
      "source": "sdkconfig.application.defaults",
      "replacements": [
        {
          "pattern": "^CONFIG_ESP_IRIS_USB_PRODUCT=\"[^\"\\n]*\"",
          "replacement": "CONFIG_ESP_IRIS_USB_PRODUCT=\"ESP-Iris Mosaico {{project_name}}\""
        }
      ]
    },
    {
      "source": "main/CMakeLists.txt",
      "replacements": [
        {
          "pattern": "\\$\\{CMAKE_CURRENT_LIST_DIR\\}/../\\.\\./\\.\\./tools/pack_gsp_partition\\.py",
          "replacement": "${CMAKE_CURRENT_LIST_DIR}/{{gsp_partition_packer|cmake}}"
        }
      ]
    },
    {
      "source": "main/idf_component.yml",
      "replacements": [
        {
          "pattern": "^    override_path: \\.\\./\\.\\./\\.\\./submodule/esp-mosaico-bsp/components/esp-mosaico-bsp$",
          "replacement": "    override_path: {{bsp_component|json}}"
        },
        {
          "pattern": "^    override_path: \\.\\./\\.\\./\\.\\./submodule/esp-mosaico-utils/ESP-Iris/components/esp_iris$",
          "replacement": "    override_path: {{iris_component|json}}"
        }
      ]
    },
    {
      "source": "main/main.c",
      "replacements": [
        {
          "pattern": "^static const char \\*TAG = \"hello_world\";",
          "replacement": "static const char *TAG = \"{{project_name}}\";"
        }
      ]
    },
    {
      "source": "main/hello_ui.c"
    },
    {
      "source": "main/hello_ui.h"
    },
    {
      "source": "main/board_display.c"
    },
    {
      "source": "main/board_display.h"
    },
    {
      "source": "main/iris_screen_mirror.c"
    },
    {
      "source": "main/iris_screen_mirror.h"
    },
    {
      "source": "main/ui_bundle.c"
    },
    {
      "source": "main/ui_bundle.h"
    },
    {
      "source": "pc/CMakeLists.txt"
    },
    {
      "source": "pc/platform_pc.c"
    },
    {
      "source": "ui/main.json"
    },
    {
      "source": "ui/fonts/DejaVuSans.ttf"
    },
    {
      "source": "ui/fonts/DejaVuSans-Bold.ttf"
    },
    {
      "source": "ui/fonts/LICENSE"
    }
  ]
}
