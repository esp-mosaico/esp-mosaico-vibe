menu "Hello World OTA"

config GET_STARTED_RECOVERY
    bool
    default n

config GET_STARTED_AUTO_ACCEPT
    bool "Automatically accept a pending OTA image"
    default y
    help
        Mark the installed image healthy after ESP-Iris starts.

config GET_STARTED_ACCEPT_DELAY_MS
    int "Automatic acceptance delay (milliseconds)"
    range 1000 30000
    default 3000
    depends on GET_STARTED_AUTO_ACCEPT

endmenu
