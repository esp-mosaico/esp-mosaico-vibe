CONFIG_IDF_TARGET="esp32s3"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# The selected Board owns the factory layout; avoid the built-in 1 MiB app.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="shared/boards/esp32-s3-box-3/partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_HZ=1000

# Keep the game main task on CPU1 across native and Iris builds.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
