CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="2.3.0-recovery"

# ESP-Iris owns the separate TinyUSB High-Speed device. Keep the built-in USB
# Serial/JTAG controller as the primary blocking console so boot, update, and
# panic output is not dropped by the non-blocking secondary-console path.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_ESP_IRIS_OTA=y
# Reduce OTA request and flash-write count while keeping each aligned data
# block plus its offset inside the protocol's 4000-byte payload limit.
CONFIG_ESP_IRIS_OTA_CHUNK_BYTES=3968
CONFIG_ESP_IRIS_SYSTEM_INVENTORY=y
CONFIG_ESP_IRIS_SYSTEM_UPDATE=y
CONFIG_IRIS_FACTORY_SYSTEM_UPDATE_BACKEND=y
CONFIG_IRIS_FACTORY_HTTP_SYSTEM_UPDATE=y
CONFIG_ESP_IRIS_TRANSPORT_TCP=y
CONFIG_ESP_IRIS_TCP_PAIRING=y
# Plain HTTP is available as an explicit development option; reviewed
# recovery images require certificate-verified HTTPS by default.
# CONFIG_IRIS_FACTORY_HTTP_SYSTEM_UPDATE_ALLOW_PLAIN_HTTP is not set
# CONFIG_IRIS_FACTORY_HTTP_SYSTEM_UPDATE_AUTO_START is not set
CONFIG_IRIS_FACTORY_NAND_SYSTEM_UPDATE=y
# NAND is mounted read-write, exposed as ESP-Iris volume "nand", and never
# formatted by Recovery.
# CONFIG_IRIS_FACTORY_NAND_SYSTEM_UPDATE_AUTO_START is not set
CONFIG_LITTLEFS_OBJ_NAME_LEN=255
CONFIG_LITTLEFS_CACHE_SIZE=4096
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM=y
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico Factory"
