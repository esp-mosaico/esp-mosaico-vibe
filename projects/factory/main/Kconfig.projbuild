menu "Iris Factory Recovery"

config FACTORY_RECOVERY_FIRMWARE
    bool
    default y
    select ESP_IRIS_OTA
    help
        Identify this project as the retained Recovery firmware and enable the
        Recovery-only ESP-Iris OTA writer.

config IRIS_FACTORY_WIFI_MAX_NETWORKS
    int "Maximum Wi-Fi scan results shown"
    range 4 16
    default 8

config IRIS_FACTORY_WIFI_CONNECT_TIMEOUT_MS
    int "Wi-Fi connection timeout (milliseconds)"
    range 5000 60000
    default 15000

config IRIS_FACTORY_MDNS_PREFIX
    string "mDNS hostname prefix"
    default "mosaico"

config IRIS_FACTORY_SYSTEM_UPDATE_BACKEND
    bool "Register the unsigned full-system update Flash backend"
    default y
    depends on ESP_IRIS_SYSTEM_UPDATE && !SECURE_FLASH_ENC_ENABLED
    help
        Accept unsigned manifests and allow recovery to update ota_0, the
        bootloader and the partition table. Transport/session access control,
        manifest/component SHA-256, image validation and protected-partition
        policy still apply, but there is no release-key authentication.

        The recovery, sysmeta, OTA data, PHY data, core-dump and application
        NVS regions must retain their current offsets and sizes. ota_0 must
        retain its start address; its size may change only when the same plan
        supplies an application image that fits the target layout.

        This first product backend intentionally rejects flash-encrypted
        builds. System Inventory remains available without a writer.

config IRIS_FACTORY_HTTP_SYSTEM_UPDATE
    bool "Enable recovery HTTP(S) system-update pull"
    default n
    depends on IRIS_FACTORY_SYSTEM_UPDATE_BACKEND
    select MBEDTLS_CERTIFICATE_BUNDLE
    help
        Register RPC 0x1201/1. Its payload is a manifest.json URL. Recovery
        downloads the manifest and each root-level component file from the
        same directory, then feeds the existing product Flash-policy backend.
        The update remains unsigned until a product release key is configured.

config IRIS_FACTORY_HTTP_SYSTEM_UPDATE_ALLOW_PLAIN_HTTP
    bool "Allow unencrypted HTTP update URLs"
    default n
    depends on IRIS_FACTORY_HTTP_SYSTEM_UPDATE
    help
        Development-only option for trusted isolated networks. HTTPS with
        certificate verification remains the production default.

config IRIS_FACTORY_HTTP_SYSTEM_UPDATE_TIMEOUT_MS
    int "HTTP operation timeout (milliseconds)"
    range 1000 120000
    default 30000
    depends on IRIS_FACTORY_HTTP_SYSTEM_UPDATE

config IRIS_FACTORY_HTTP_SYSTEM_UPDATE_NETWORK_WAIT_MS
    int "Maximum wait for Wi-Fi connectivity (milliseconds)"
    range 1000 600000
    default 60000
    depends on IRIS_FACTORY_HTTP_SYSTEM_UPDATE

config IRIS_FACTORY_HTTP_SYSTEM_UPDATE_TASK_STACK
    int "HTTP system-update task stack size"
    range 6144 16384
    default 8192
    depends on IRIS_FACTORY_HTTP_SYSTEM_UPDATE

config IRIS_FACTORY_HTTP_SYSTEM_UPDATE_AUTO_START
    bool "Automatically pull the configured manifest in Recovery"
    default n
    depends on IRIS_FACTORY_HTTP_SYSTEM_UPDATE

config IRIS_FACTORY_HTTP_SYSTEM_UPDATE_MANIFEST_URL
    string "Automatic system-update manifest URL"
    default ""
    depends on IRIS_FACTORY_HTTP_SYSTEM_UPDATE_AUTO_START
    help
        Absolute URL of manifest.json. Component file names in the manifest
        are resolved relative to this URL. Leave empty to disable auto-start.

config IRIS_FACTORY_NAND_SYSTEM_UPDATE
    bool "Enable recovery NAND LittleFS system-update source"
    default n
    depends on IRIS_FACTORY_SYSTEM_UPDATE_BACKEND
    select NAND_FLASH_ENABLE_BDL
    help
        Register RPC 0x1201/2. Its payload is an absolute manifest path below
        /nand. Recovery mounts the board SPI NAND LittleFS read-write, exposes
        the complete /nand tree as the writable ESP-Iris volume "nand", and
        reads the manifest plus every root-level component from its directory.
        Mount failures never format the NAND and do not prevent Recovery USB
        maintenance from starting.
        The Recovery UI scans /nand/system-update/manifest.json and one level
        of release subdirectories so an operator can select a bundle locally.

config IRIS_FACTORY_NAND_SYSTEM_UPDATE_TASK_STACK
    int "NAND system-update task stack size"
    range 6144 16384
    default 8192
    depends on IRIS_FACTORY_NAND_SYSTEM_UPDATE

config IRIS_FACTORY_NAND_SYSTEM_UPDATE_AUTO_START
    bool "Automatically apply the configured NAND bundle in Recovery"
    default n
    depends on IRIS_FACTORY_NAND_SYSTEM_UPDATE

config IRIS_FACTORY_NAND_SYSTEM_UPDATE_MANIFEST_PATH
    string "Automatic NAND system-update manifest path"
    default "/nand/system-update/manifest.json"
    depends on IRIS_FACTORY_NAND_SYSTEM_UPDATE_AUTO_START
    help
        Absolute LittleFS path below /nand. Component file names in the
        manifest are resolved relative to this file. Leave empty to disable
        auto-start.

endmenu
