menu "Iris Factory OTA"

config GET_STARTED_RECOVERY
    bool "Build the retained factory recovery image"
    default n
    select ESP_IRIS_OTA
    help
        Build the image installed in the factory partition. It remains outside
        the single normal OTA slot and writes updates while running from factory.

choice GET_STARTED_RECOVERY_IMAGE_SOURCE
    prompt "Recovery image source"
    default GET_STARTED_RECOVERY_IMAGE_PREBUILT
    depends on !GET_STARTED_RECOVERY
    help
        Select the recovery image prepared alongside application and candidate
        builds. The selected image is staged under the active build directory.

config GET_STARTED_RECOVERY_IMAGE_PREBUILT
    bool "Use checked-in prebuilt recovery image"
    help
        Validate and copy the recovery image stored in prebuilt/recovery. This
        is the fast path for normal development builds.

config GET_STARTED_RECOVERY_IMAGE_BUILD
    bool "Build recovery from current source"
    help
        Build recovery in an isolated sub-build before staging it. Select this
        while changing recovery source code or configuration.

endchoice

config GET_STARTED_AUTO_ACCEPT
    bool "Automatically accept a pending OTA image"
    default y
    depends on !GET_STARTED_RECOVERY
    help
        Mark an OTA image healthy after ESP-Iris starts. Disable this when
        intentionally testing bootloader rollback.

config GET_STARTED_ACCEPT_DELAY_MS
    int "Automatic acceptance delay (milliseconds)"
    range 1000 30000
    default 3000
    depends on GET_STARTED_AUTO_ACCEPT && !GET_STARTED_RECOVERY

menu "Iris Factory Recovery"
    depends on GET_STARTED_RECOVERY

config IRIS_FACTORY_WIFI_MAX_NETWORKS
    int "Maximum Wi-Fi scan results shown"
    range 4 16
    default 8

config IRIS_FACTORY_WIFI_CONNECT_TIMEOUT_MS
    int "Wi-Fi connection timeout (milliseconds)"
    range 5000 60000
    default 15000

config IRIS_FACTORY_MDNS_PREFIX
    string "mDNS hostname prefix"
    default "mosaico"

config IRIS_FACTORY_SYSTEM_UPDATE_BACKEND
    bool "Register the product full-system update Flash backend"
    default n
    depends on ESP_IRIS_SYSTEM_UPDATE && !SECURE_FLASH_ENC_ENABLED
    help
        Authenticate signed manifests on the device and allow recovery to
        update ota_0, the bootloader and the partition table. The recovery,
        factory Wi-Fi NVS, OTA data and sysmeta regions must retain their
        current offsets and sizes. Other partition-table entries may change.

        This first product backend intentionally rejects flash-encrypted
        builds. System Inventory remains available without a writer.

config IRIS_FACTORY_SYSTEM_UPDATE_KEY_ID
    string "System-update release key identifier"
    default "product-release-1"
    depends on IRIS_FACTORY_SYSTEM_UPDATE_BACKEND
    help
        Must exactly match signature.key_id in the signed manifest.

config IRIS_FACTORY_SYSTEM_UPDATE_PUBLIC_KEY_DER_HEX
    string "ECDSA P-256 public key (SPKI DER hex)"
    default ""
    depends on IRIS_FACTORY_SYSTEM_UPDATE_BACKEND
    help
        Hex encoding of the SubjectPublicKeyInfo DER public key. Generate it
        from the separately managed release public key with:

        openssl pkey -pubin -in release-public-key.pem -outform DER | xxd -p -c 999

        The private signing key must never be stored in this repository or on
        the Gateway host.

endmenu

endmenu
